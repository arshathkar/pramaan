# Pramaan — Environment Configuration (Development)
# Copy this file to .env and update the values

# Identity
APP_NAME=Pramaan
APP_ENV=demo

# Database
DATABASE_URL=sqlite+aiosqlite:///./pramaan.db

# Security — Generate with: python gen_secrets.py
APP_SECRET_KEY=CHANGE-ME-generate-with-scripts-gen_secrets
JWT_SECRET=CHANGE-ME-generate-with-scripts-gen_secrets
FILE_ENC_KEY=CHANGE-ME-generate-with-scripts-gen_secrets
COOKIE_SECURE=false

# Demo clock (ISO date; comment out to use real clock)
DEMO_TODAY=2026-10-23

# OCR
TESSERACT_CMD=tesseract
OCR_ENGINE=tesseract

# Features
ENABLE_SCENE_CHECK=false
ASSISTANT_MODE=full

# Paths
MODEL_DIR=backend/models
UPLOAD_DIR=backend/uploads

# Limits
RETENTION_DAYS=365
MAX_UPLOAD_MB=15
MAX_VIDEO_MB=50
MAX_FILES_PER_APP=25
SLA_DAYS=5
RECTIFICATION_DAYS=15

# Authority mock
AUTHORITY_BASE_URL=http://localhost:8100
AUTHORITY_SIM_TOKEN=sim-token-change-me

# Logging
LOG_LEVEL=INFO

# Ports
API_PORT=8000
AUTHORITY_PORT=8100
